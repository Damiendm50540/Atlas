# Backend : API FastAPI + analyse MediaPipe/OpenCV
FROM python:3.12-slim

# libs système requises par OpenCV / MediaPipe
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgles2 libegl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py history.py ./

# utilisateur non-root ; les dossiers appartiennent à "app" pour que les volumes nommés soient inscriptibles
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data /app/uploads /app/models \
    && chown -R app:app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/status', timeout=3)"

# un seul worker : l'état (flux, alarme) vit en mémoire dans le processus
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
