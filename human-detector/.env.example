# Copie ce fichier en ".env" et remplis ce que tu veux utiliser.

# --- Authentification locale ---
# Génère un mot de passe : python3 -c "import secrets; print(secrets.token_urlsafe(18))"
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_USER_USERNAME=user
APP_USER_PASSWORD=
# Laisse vide pour un secret aléatoire auto-généré dans data/.session_secret
APP_SESSION_SECRET=
# APP_MAX_UPLOAD_MB=500

# --- Agent léger des métriques Raspberry Pi ---
# Laisse vide pour désactiver l'agent. Génère un jeton aléatoire et utilise-le aussi sur le Pi.
ATLAS_AGENT_TOKEN=

# --- Notification téléphone (app ntfy, gratuite) ---
# Choisis un nom long et secret, puis abonne-toi au même nom dans l'app ntfy.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Notification email (SMTP) ---
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, port 587, mot de passe d'application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
